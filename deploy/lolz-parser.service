[Unit]
Description=Lolz Parser FastAPI (uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/lolz-parser
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/lolz-parser/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 13337
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
