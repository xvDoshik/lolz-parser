# Copy to .env and fill in. Gate is off if SONIC_GATE_PASSWORD_HASH is empty.
# Generate hash:  python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"

SONIC_GATE_PASSWORD_HASH=
SONIC_GATE_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: behind reverse proxy without HTTPS in dev
# SONIC_GATE_ALLOW_HTTP=1
